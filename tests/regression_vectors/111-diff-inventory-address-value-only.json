{
  "title": "Changing a referenced address definition does not edit the policy",
  "command": "diff",
  "options": ["--fail-on-change"],
  "before": [
    "config firewall address", "edit Sample", "set subnet 192.0.2.0 255.255.255.0", "next", "end",
    "config firewall policy", "edit 7", "set srcaddr Sample", "set dstaddr all", "next", "end"
  ],
  "after": [
    "config firewall address", "edit Sample", "set subnet 198.51.100.0 255.255.255.0", "next", "end",
    "config firewall policy", "edit 7", "set srcaddr Sample", "set dstaddr all", "next", "end"
  ],
  "expected": {"exit": 0, "before_order": [7], "after_order": [7], "has_changes": false}
}
