{
  "title": "A configured service alias never resolves an address reference",
  "command": "summary",
  "config": [
    "config firewall service custom", "edit Palette", "next", "end",
    "config firewall policy", "edit 8", "set srcaddr Palette", "set dstaddr all", "set service Palette", "next", "end"
  ],
  "expected": {"exit": 1, "findings": [["unknown-address-reference", 6, "policy", 8, "srcaddr", "Palette"]]}
}
