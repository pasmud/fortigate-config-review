{
  "title": "Removing an explicit accept action reports the normalized deny value",
  "command": "diff",
  "before": ["config firewall policy", "edit 6", "set srcaddr all", "set dstaddr all", "set action accept", "next", "end"],
  "after": ["config firewall policy", "edit 6", "set srcaddr all", "set dstaddr all", "next", "end"],
  "expected": {"exit": 0, "before_order": [6], "after_order": [6], "has_changes": true,
    "changed": [{"id": 6, "fields": {"action": {"before": ["accept"], "after": ["deny"]}}}]}
}
