{
  "title": "Each side gets its own finding kind even when a policy ID survives",
  "command": "diff",
  "options": ["--fail-on-change"],
  "before": ["config firewall policy", "edit 4", "set srcaddr Ghost", "set dstaddr all", "set service ALL", "next", "end"],
  "after": ["config firewall policy", "edit 4", "set srcaddr all", "set dstaddr all", "set service All", "next", "end"],
  "expected": {"exit": 1, "before_order": [4], "after_order": [4], "has_changes": true,
    "changed": [{"id": 4, "fields": {"srcaddr": {"before": ["Ghost"], "after": ["all"]}, "service": {"before": ["ALL"], "after": ["All"]}}}],
    "findings": {"before": [["unknown-address-reference", 2, "policy", 4, "srcaddr", "Ghost"]],
      "after": [["service-reference-case-mismatch", 2, "policy", 4, "service", "All"]]}}
}
