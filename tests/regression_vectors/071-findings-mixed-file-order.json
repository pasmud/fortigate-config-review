{
  "title": "Service and address findings are merged in source line order",
  "command": "summary",
  "config": [
    "config firewall service group", "edit Catalog", "set member All", "next", "end",
    "config firewall policy", "edit 6", "set service Catalog", "set dstaddr Ghost", "next", "end",
    "config firewall addrgrp", "edit Box", "set exclude-member Box", "next", "end"
  ],
  "expected": {"exit": 1, "findings": [
    ["service-reference-case-mismatch", 2, "service-group", "Catalog", "member", "All"],
    ["missing-address-list", 7, "policy", 6, "srcaddr", null],
    ["unknown-address-reference", 7, "policy", 6, "dstaddr", "Ghost"],
    ["group-cycle", 13, "group", "Box", "exclude-member", "Box"]
  ]}
}
