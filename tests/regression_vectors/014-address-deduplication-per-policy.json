{
  "title": "The same unknown label is reported for each referencing policy",
  "command": "summary",
  "config": [
    "config firewall policy", "edit 31", "set srcaddr Ghost", "set dstaddr all", "next",
    "edit 2", "set srcaddr Ghost", "set dstaddr all", "next", "end"
  ],
  "expected": {"exit": 1, "findings": [
    ["unknown-address-reference", 2, "policy", 31, "srcaddr", "Ghost"],
    ["unknown-address-reference", 6, "policy", 2, "srcaddr", "Ghost"]
  ]}
}
