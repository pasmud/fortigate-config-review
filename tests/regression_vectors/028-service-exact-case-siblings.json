{
  "title": "Exact service aliases win when both case spellings are configured",
  "command": "summary",
  "config": [
    "config firewall service custom", "edit Ruler", "next", "edit ruler", "next", "end",
    "config firewall policy", "edit 8", "set srcaddr all", "set dstaddr all", "set service Ruler ruler RULER", "next", "end"
  ],
  "expected": {"exit": 1, "findings": [["service-reference-case-mismatch", 8, "policy", 8, "service", "RULER"]]}
}
