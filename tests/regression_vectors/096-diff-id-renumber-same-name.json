{
  "title": "Renumbering a named policy is an addition and removal, not an edit",
  "command": "diff",
  "options": ["--fail-on-change"],
  "before": ["config firewall policy", "edit 18", "set name Catalog", "set srcaddr all", "set dstaddr all", "next", "end"],
  "after": ["config firewall policy", "edit 4", "set name Catalog", "set srcaddr all", "set dstaddr all", "next", "end"],
  "expected": {"exit": 3, "before_order": [18], "after_order": [4], "added": [4], "removed": [18], "has_changes": true}
}
