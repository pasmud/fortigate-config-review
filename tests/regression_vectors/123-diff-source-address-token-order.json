{
  "title": "Swapping source address tokens changes the field, not policy order",
  "command": "diff",
  "before": [
    "config firewall address", "edit Card", "next", "end",
    "config firewall policy", "edit 7", "set srcaddr all Card", "set dstaddr all", "next", "end"
  ],
  "after": [
    "config firewall address", "edit Card", "next", "end",
    "config firewall policy", "edit 7", "set srcaddr Card all", "set dstaddr all", "next", "end"
  ],
  "expected": {"exit": 0, "before_order": [7], "after_order": [7], "has_changes": true,
    "changed": [{"id": 7, "fields": {"srcaddr": {"before": ["all", "Card"], "after": ["Card", "all"]}}}]}
}
