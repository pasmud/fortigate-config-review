{
  "title": "Escaped quotes in an address label survive reference lookup",
  "command": "summary",
  "config": [
    "config firewall address", "edit \"Desk \\\"Mini\\\"\"", "next", "edit Mini", "next", "end",
    "config firewall policy", "edit 7", "set srcaddr all", "set dstaddr \"Desk \\\"Mini\\\"\"", "next", "end"
  ],
  "expected": {"exit": 0, "candidates": ["Mini"]}
}
