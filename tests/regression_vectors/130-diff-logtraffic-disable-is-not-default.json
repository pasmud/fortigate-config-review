{
  "title": "Explicitly disabled logging is not normalized to omitted logging",
  "command": "diff",
  "before": ["config firewall policy", "edit 8", "set srcaddr all", "set dstaddr all", "next", "end"],
  "after": ["config firewall policy", "edit 8", "set srcaddr all", "set dstaddr all", "set logtraffic disable", "next", "end"],
  "expected": {"exit": 0, "before_order": [8], "after_order": [8], "has_changes": true,
    "changed": [{"id": 8, "fields": {"logtraffic": {"before": null, "after": ["disable"]}}}]}
}
