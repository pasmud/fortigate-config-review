{
  "title": "A new destination interface is an edit without a lookup finding",
  "command": "diff",
  "before": ["config firewall policy", "edit 14", "set srcaddr all", "set dstaddr all", "next", "end"],
  "after": ["config firewall policy", "edit 14", "set srcaddr all", "set dstaddr all", "set dstintf DemoShelf", "next", "end"],
  "expected": {"exit": 0, "before_order": [14], "after_order": [14], "has_changes": true,
    "changed": [{"id": 14, "fields": {"dstintf": {"before": null, "after": ["DemoShelf"]}}}]}
}
