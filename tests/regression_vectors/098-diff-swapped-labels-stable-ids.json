{
  "title": "Swapped policy names are two edits rather than an order change",
  "command": "diff",
  "before": [
    "config firewall policy", "edit 50", "set name Left", "set srcaddr all", "set dstaddr all", "next",
    "edit 7", "set name Right", "set srcaddr all", "set dstaddr all", "next", "end"
  ],
  "after": [
    "config firewall policy", "edit 50", "set name Right", "set srcaddr all", "set dstaddr all", "next",
    "edit 7", "set name Left", "set srcaddr all", "set dstaddr all", "next", "end"
  ],
  "expected": {"exit": 0, "before_order": [50, 7], "after_order": [50, 7], "has_changes": true,
    "changed": [{"id": 50, "fields": {"name": {"before": ["Left"], "after": ["Right"]}}},
      {"id": 7, "fields": {"name": {"before": ["Right"], "after": ["Left"]}}}]}
}
