{
  "title": "Interior spaces in quoted address keys are not collapsed",
  "command": "summary",
  "config": [
    "config firewall address", "edit \"Blue  Shelf\"", "next", "edit \"Blue Shelf\"", "next", "end",
    "config firewall policy", "edit 7", "set srcaddr all", "set dstaddr \"Blue Shelf\"", "next", "end"
  ],
  "expected": {"exit": 0, "candidates": ["Blue  Shelf"]}
}
