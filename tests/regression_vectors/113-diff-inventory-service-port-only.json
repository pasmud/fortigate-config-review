{
  "title": "A changed custom service definition does not edit its referencing rule",
  "command": "diff",
  "before": [
    "config firewall service custom", "edit Preview", "set tcp-portrange 8443", "next", "end",
    "config firewall policy", "edit 4", "set srcaddr all", "set dstaddr all", "set service Preview", "next", "end"
  ],
  "after": [
    "config firewall service custom", "edit Preview", "set tcp-portrange 9443", "next", "end",
    "config firewall policy", "edit 4", "set srcaddr all", "set dstaddr all", "set service Preview", "next", "end"
  ],
  "expected": {"exit": 0, "before_order": [4], "after_order": [4], "has_changes": false}
}
