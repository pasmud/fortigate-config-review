{
  "title": "An address FQDN does not become a configured lookup key",
  "command": "summary",
  "config": [
    "config firewall address", "edit SampleDesk", "set type fqdn", "set fqdn desk.example.invalid", "next", "end",
    "config firewall policy", "edit 5", "set srcaddr desk.example.invalid", "set dstaddr all", "next", "end"
  ],
  "expected": {"exit": 1, "findings": [["unknown-address-reference", 8, "policy", 5, "srcaddr", "desk.example.invalid"]]}
}
