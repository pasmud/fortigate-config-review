{
  "title": "A policy service list reorder is reported even for built-in labels",
  "command": "diff",
  "before": ["config firewall policy", "edit 4", "set srcaddr all", "set dstaddr all", "set service DNS HTTPS", "next", "end"],
  "after": ["config firewall policy", "edit 4", "set srcaddr all", "set dstaddr all", "set service HTTPS DNS", "next", "end"],
  "expected": {"exit": 0, "before_order": [4], "after_order": [4], "has_changes": true,
    "changed": [{"id": 4, "fields": {"service": {"before": ["DNS", "HTTPS"], "after": ["HTTPS", "DNS"]}}}]}
}
